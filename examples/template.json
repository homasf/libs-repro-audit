{
  "record_version": "2.0",
  "_instructions": "Fill every value from the PRINTED tables/equations/text of the paper you are auditing. Keep a 'source' note for each block (table number, equation number, section). Delete any block that does not apply. Then run: libs-audit yourfile.json -o report.md",

  "paper": {
    "title": "<title of the audited publication>",
    "authors": "<authors>",
    "journal": "<journal, volume, year, pages>",
    "doi": "<doi>",
    "transcribed_by": "<your name>",
    "transcription_date": "<YYYY-MM-DD>"
  },

  "validation": {
    "tolerance_percent": 1.0,
    "tolerance_source": "<where the agreement claim is stated>",
    "points": [
      {"analyte": "<element>", "label": "<estimate type>",
       "method_value": 0.0, "reference_value": 0.0,
       "units": "ppm", "source": "<table>"}
    ]
  },

  "stark_checks": [
    {"sample": "<sample id>", "line": "<species and wavelength>",
     "fwhm_nm": 0.0, "w_s_nm": 0.0, "exponent": 16,
     "ne_comparison_mantissa": 0.0, "source": "<figure/table>"}
  ],

  "instrument": {
    "resolving_power": 0,
    "diagnostic_wavelength_nm": 0.0,
    "source": "<where stated>"
  },

  "scale_checks": [
    {"analyte": "<element>", "a": 0.0, "b": 0.0, "equation_exponent": 16,
     "ne_mantissa": 0.0, "candidate_exponents": [16, 17],
     "printed_estimate": 0.0, "stated_exponent": 16, "source": "<table>"}
  ],

  "equations": [
    {"analyte": "<element>", "parameter": "Ne", "a": 0.0, "b": 0.0,
     "operative_value": 0.0, "printed_estimate": 0.0, "source": "<table>"}
  ],

  "qualitative": {
    "lte_check_reported": false,
    "optical_thinness_or_self_absorption_reported": false,
    "atomic_data_provenance_reported": false,
    "instrumental_width_reported": false,
    "full_precision_coefficients_available": false
  }
}
